{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:goreecloud:wardveil:incident:0.1.0",
  "title": "Wardveil Next-Upgrade Incident",
  "description": "Evidence-driven Wardveil incident record. Resolution requires explicit evidence; uncertainty remains individually attributable and may block stronger lifecycle states.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "record_type", "incident_id", "correlation_id", "severity", "state", "owner_role", "target", "initiating_evidence_refs", "source_record_refs", "quarantine_object_refs", "recovery_refs", "everkeep_evidence_refs", "wardveil_recovery_verification_refs", "reconciliation_open", "open_reconciliation_refs", "timeline", "transitions"],
  "properties": {
    "contract_version": {"const": "0.1.0"},
    "record_type": {"const": "incident"},
    "incident_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "severity": {"type": "string", "enum": ["informational", "low", "medium", "high", "critical"]},
    "state": {"type": "string", "enum": ["open", "investigating", "containment_pending", "contained", "recovery_pending", "recovering", "verification_pending", "resolved", "archived"]},
    "owner_role": {"type": "string", "minLength": 1, "maxLength": 128},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "resource_type", "resource_id"],
      "properties": {
        "authority": {"type": "string", "minLength": 1, "maxLength": 128},
        "resource_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "resource_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "initiating_evidence_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "source_record_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "quarantine_object_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "recovery_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "everkeep_evidence_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "wardveil_recovery_verification_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "reconciliation_open": {"type": "boolean"},
    "open_reconciliation_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "timeline": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "event_type", "producer", "observed_at", "summary", "evidence_refs", "source_record_refs", "execution_state"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "event_type": {"type": "string", "enum": ["finding", "threat_detection", "trust_change", "policy_decision", "execution_authorization", "protection_action", "quarantine", "reconciliation", "recovery_action", "everkeep_recovery_evidence", "wardveil_recovery_verification", "resolution"]},
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "authority_domain"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 128},
              "authority_domain": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          },
          "observed_at": {"type": "string", "format": "date-time"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 512},
          "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "source_record_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "execution_state": {"type": "string", "enum": ["not_applicable", "requested", "executing", "verified", "failed", "uncertain"]},
          "quarantine_object_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "recovery_ref": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "from_state", "to_state", "observed_at", "reason", "actor_id", "evidence_refs"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "from_state": {"type": ["string", "null"]},
          "to_state": {"type": "string", "enum": ["open", "investigating", "containment_pending", "contained", "recovery_pending", "recovering", "verification_pending", "resolved", "archived"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 256},
          "actor_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_outcome", "evidence_refs"],
      "properties": {
        "final_outcome": {"type": "string", "minLength": 1, "maxLength": 256},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["resolved", "archived"]}}, "required": ["state"]},
      "then": {
        "required": ["resolution"],
        "properties": {
          "timeline": {
            "contains": {"type": "object", "properties": {"event_type": {"const": "resolution"}}, "required": ["event_type"]},
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "contained"}}, "required": ["state"]},
      "then": {
        "properties": {
          "timeline": {
            "contains": {
              "type": "object",
              "properties": {
                "event_type": {"enum": ["protection_action", "quarantine"]},
                "execution_state": {"const": "verified"}
              },
              "required": ["event_type", "execution_state"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {"properties": {"reconciliation_open": {"const": true}}, "required": ["reconciliation_open"]},
      "then": {
        "properties": {"open_reconciliation_refs": {"minItems": 1}},
        "not": {"properties": {"state": {"enum": ["contained", "verification_pending", "resolved", "archived"]}}, "required": ["state"]}
      }
    },
    {
      "if": {"properties": {"reconciliation_open": {"const": false}}, "required": ["reconciliation_open"]},
      "then": {"properties": {"open_reconciliation_refs": {"maxItems": 0}}}
    }
  ]
}
