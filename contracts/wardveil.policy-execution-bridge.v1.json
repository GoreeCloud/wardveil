{
  "contract_version": "0.1.0",
  "component": "Wardveil Policy-to-Execution Authorization Bridge",
  "work_package": "J",
  "purpose": "bind a usable Wardveil v2 Policy decision into the existing Foundation 0.9 runtime execution-authorization path without creating a second authorization format or transferring target authority",
  "source_policy_contract": "contracts/wardveil.policy-decision.v2.schema.json",
  "execution_authorization_contract": "contracts/wardveil.runtime-authorization.json",
  "durable_execution_state_contract": "contracts/wardveil.execution-state.json",
  "bridge_rules": {
    "usable_policy_decision_required": true,
    "allowed_policy_outcomes": ["allow", "allow_with_obligations"],
    "denied_policy_outcomes": ["deny", "require_step_up", "defer", "unknown"],
    "revoked_policy_decision_fails_closed": true,
    "expired_policy_decision_fails_closed": true,
    "future_dated_policy_decision_fails_closed": true,
    "concrete_action_source": "policy_decision.request.action",
    "high_impact_action_required": true,
    "exact_target_source": "policy_decision.request.target",
    "target_resource_type_must_be_explicit": true,
    "all_policy_obligations_require_evidence_before_authorization": true,
    "unexpected_obligation_evidence_fails_closed": true,
    "exact_v2_decision_digest_preserved": true,
    "actor_binding_preserved": true,
    "purpose_binding_preserved": true,
    "scope_binding_preserved": true,
    "audience_binding_preserved": true,
    "trust_binding_preserved": true,
    "evidence_binding_preserved": true,
    "revocation_binding_preserved": true,
    "execution_boundary_binding_preserved": true,
    "foundation_09_authorization_wire_format_reused": true,
    "authorization_must_not_outlive_v2_decision": true,
    "policy_decision_is_execution_authorization": false,
    "authorization_transfers_target_authority": false,
    "authorization_proves_execution_success": false,
    "target_executor_must_independently_authorize_action_and_resource": true,
    "durable_claim_required_before_external_high_impact_execution_in_production": true,
    "uncertain_outcome_requires_reconciliation": true,
    "blind_reexecution_after_uncertain_outcome_allowed": false
  },
  "privacy": {
    "data_minimization_required": true,
    "raw_resource_content_required": false,
    "reusable_credentials_allowed": false,
    "signing_secrets_allowed": false,
    "obligation_evidence_references_may_be_retained": true
  },
  "production_acceptance": {
    "status": "unaccepted",
    "source_validation_is_production_acceptance": false,
    "required_evidence": [
      "production_identity_and_signing_key_acceptance",
      "approved_execution_authorization_signer",
      "authenticated_authorization_transport",
      "deployed_durable_execution_claim_and_receipt_storage",
      "authorized_target_executor",
      "authoritative_target_state_readback",
      "uncertain_outcome_reconciliation",
      "audit_ingestion",
      "security_center_visibility",
      "privacy_shield_acceptance",
      "everkeep_recovery_acceptance",
      "runtime_failure_replay_revocation_and_recovery_tests"
    ]
  }
}
