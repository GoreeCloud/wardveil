{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/contracts/wardveil.trust-posture.v1.schema.json",
  "title": "Wardveil Trust, Session, and Device Posture Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "device_id",
    "session_id",
    "runtime_id",
    "application_id",
    "action",
    "impact",
    "observed_at",
    "expires_at",
    "inputs",
    "reevaluation_triggers",
    "proposed_state"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "runtime_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "application_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "action": {"type": "string", "minLength": 1, "maxLength": 160},
    "impact": {"type": "string", "enum": ["low", "medium", "high"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "authority", "evidence_reference"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "state": {"type": "string", "enum": ["present", "missing", "stale", "conflicting", "invalid"]},
          "authority": {"type": "string", "minLength": 1, "maxLength": 128},
          "evidence_reference": {"type": ["string", "null"], "maxLength": 1000}
        }
      }
    },
    "reevaluation_triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_revoked": {"type": "boolean"},
        "credential_compromised": {"type": "boolean"},
        "runtime_integrity_failed": {"type": "boolean"},
        "material_posture_changed": {"type": "boolean"},
        "material_security_incident": {"type": "boolean"}
      }
    },
    "proposed_state": {
      "type": "string",
      "enum": ["trusted", "restricted", "unknown", "untrusted", "reauthentication_required"]
    }
  }
}
