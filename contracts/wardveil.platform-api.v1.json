{
  "schema_version": 1,
  "contract_id": "goreecloud.wardveil.platform-api.v1",
  "api_version": "wardveil-persistence-rpc/v1",
  "component_id": "goreecloud-wardveil-security",
  "implementation": "cloudflare/src/index.ts",
  "transport": "cloudflare-worker-service-binding-rpc",
  "service_name": "goreecloud-wardveil-persistence",
  "endpoint_reference": "service-binding://goreecloud-wardveil-persistence",
