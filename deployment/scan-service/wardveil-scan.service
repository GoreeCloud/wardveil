[Unit]
Description=Wardveil authenticated Scan transport
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/goreecloud/wardveil/scan-service/current
EnvironmentFile=/etc/goreecloud/wardveil/clamav.env
EnvironmentFile=-/etc/goreecloud/wardveil/scan-service.env
Environment=WARDVEIL_SCAN_REPLAY_DB=/var/lib/wardveil-scan/replay.sqlite3
LoadCredential=wardveil-scan-callers.json:/etc/goreecloud/wardveil/scan-callers.json
StateDirectory=wardveil-scan
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/goreecloud/wardveil/scan-service/current/scripts/serve_wardveil_scan.py
Restart=on-failure
RestartSec=3
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8

[Install]
WantedBy=multi-user.target
