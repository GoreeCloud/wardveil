# Wardveil Scan non-secret runtime configuration example.
# Real caller secrets belong in /etc/goreecloud/wardveil/scan-callers.json and
# are delivered to the DynamicUser service with systemd LoadCredential.
WARDVEIL_SCAN_SERVICE_PORT=8791
WARDVEIL_SCAN_MAX_CONCURRENT_SCANS=8
WARDVEIL_SCAN_REPLAY_MAX_ENTRIES=4096
WARDVEIL_SCAN_REPLAY_TTL_SECONDS=180
