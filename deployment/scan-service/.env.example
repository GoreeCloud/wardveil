# Wardveil Scan transport defaults. Never commit real caller secrets.
WARDVEIL_SCAN_BIND=127.0.0.1:8788
WARDVEIL_SCAN_ALLOW_NON_LOOPBACK=false
WARDVEIL_SCAN_MAX_CLOCK_SKEW_SECONDS=60
WARDVEIL_SCAN_MAX_BODY_BYTES=26214400
# Required in deployment. JSON array of caller_id/key_id/secret/resource_types entries.
WARDVEIL_SCAN_CALLERS_JSON=[]
