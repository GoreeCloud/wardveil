# Wardveil Scan authenticated transport configuration example.
# Never commit or print real caller secrets. Provision the real JSON only in
# /etc/goreecloud/wardveil/scan-service.env with root-readable permissions.
WARDVEIL_SCAN_SERVICE_PORT=8791
# JSON array entries: caller_id, key_id, secret (>=32 bytes), resource_types,
# and optional active. Empty source default intentionally makes startup fail.
WARDVEIL_SCAN_CALLERS_JSON=[]
