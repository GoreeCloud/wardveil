{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goreecloud-wardveil-quarantine-executor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "WARDVEIL_AUTH_ISSUER_ID": "wardveil-policy-runtime",
    "WARDVEIL_AUTH_EXECUTOR_ID": "wardveil-quarantine-executor-runtime",
    "WARDVEIL_AUTH_SIGNING_KEY_ID": "wardveil-auth-current",
    "WARDVEIL_QUARANTINE_RESOURCE_TYPES": "mail_attachment,drive_file,browser_download,ai_artifact",
    "WARDVEIL_QUARANTINE_TARGET_SERVICE": "REPLACE_AT_DEPLOYMENT",
    "WARDVEIL_PRODUCTION_RUNTIME_STATUS": "unaccepted"
  },
  "services": [
    {
      "binding": "WARDVEIL_PERSISTENCE_SERVICE",
      "service": "goreecloud-wardveil-persistence"
    }
  ],
  "secrets": {
    "required": ["WARDVEIL_AUTH_VERIFICATION_KEY"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0
  }
}
